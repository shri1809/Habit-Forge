# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas URI with authentication & TLS)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/habitforge?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_secure_random_jwt_secret_min_32_characters
JWT_EXPIRES_IN=7d

# HTTP-Based Email API (Unblocked Port 443 HTTPS - Recommended for Cloud Deployments)
# Option 1: Resend (https://resend.com)
RESEND_API_KEY=re_123456789
EMAIL_FROM="HabitForge <onboarding@resend.dev>"

# Option 2: Brevo / Sendinblue (https://brevo.com - 300 free emails/day, NO custom domain required)
# BREVO_API_KEY=xkeysib-123456789

# Option 3: SendGrid (https://sendgrid.com)
# SENDGRID_API_KEY=SG.123456789

# Option 4: Legacy SMTP Fallback (Optional)
# EMAIL_USER=your_email@example.com
# EMAIL_PASS=your_email_app_password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# Client URL (for strict CORS whitelisting)
CLIENT_URL=http://localhost:5173
