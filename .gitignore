# Dependencies (NEVER commit node_modules)
node_modules/
*/node_modules/
client/node_modules/
server/node_modules/
/.pnp
.pnp.js

# Environment variables & secrets (CRITICAL: Never commit secrets)
.env
.env.*
!.env.example
!server/.env.example
!client/.env.example
!client/.env.production
!client/.env.development
server/.env
client/.env

# Build outputs
dist/
dist-ssr/
build/
client/dist/
out/
*.local

# Vite, Vitest & Bundler cache
.vite/
client/.vite/
server/.vite/
.vitest/

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Coverage
coverage/
.nyc_output/

# Editor & OS files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
ehthumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# Temporary / Scratch directories
scratch/
tmp/
temp/
